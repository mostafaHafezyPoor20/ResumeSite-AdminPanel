<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12sp"
    android:elevation="2sp"
    android:id="@+id/mainView"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="250sp"
        android:layout_height="250sp"
        android:id="@+id/imageProfile"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/icon"/>
        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12sp"
        android:hint="نام"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12sp"
            app:boxCornerRadiusTopEnd="12sp"
            app:boxCornerRadiusBottomStart="12sp"
            app:boxCornerRadiusBottomEnd="12sp"
            app:boxBackgroundColor="@color/white">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_light"
            android:inputType="textPersonName"
            android:id="@+id/name"/>
    </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12sp"
            android:hint="خلاصه مهارت ها"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12sp"
            app:boxCornerRadiusTopEnd="12sp"
            app:boxCornerRadiusBottomStart="12sp"
            app:boxCornerRadiusBottomEnd="12sp"
            app:boxBackgroundColor="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/summerSkills"
                android:inputType="textPersonName"
                android:fontFamily="@font/vazirmatn_light"/>
        </com.google.android.material.textfield.TextInputLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center"
          android:layout_marginTop="24sp">
          <View
              android:layout_width="match_parent"
              android:layout_height="1sp"
              android:background="@color/black"
              android:layout_weight="1"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="شبکه های اجتماعی"
              android:gravity="center"
              android:fontFamily="@font/vazirmatn_bold"
              android:layout_weight="1"
              android:textColor="@color/black"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="1sp"
              android:background="@color/black"
              android:layout_weight="1"/>
      </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12sp"
            android:hint="تلگرام"
            app:boxCornerRadiusTopStart="12sp"
            app:boxCornerRadiusTopEnd="12sp"
            app:boxCornerRadiusBottomStart="12sp"
            app:boxCornerRadiusBottomEnd="12sp"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_light"
                android:inputType="textPersonName"
                android:id="@+id/telegram"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12sp"
            android:hint="اینستاگرام"
            app:boxCornerRadiusTopStart="12sp"
            app:boxCornerRadiusTopEnd="12sp"
            app:boxCornerRadiusBottomStart="12sp"
            app:boxCornerRadiusBottomEnd="12sp"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_light"
                android:inputType="textPersonName"
                android:id="@+id/instagram"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12sp"
            android:textColor="@color/red"
            android:gravity="right"
            android:id="@+id/textError"
            android:visibility="gone"
            android:fontFamily="@font/vazirmatn_extra_bold"/>
<com.google.android.material.button.MaterialButton
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12sp"
    android:text="ذخیره"
    android:textColor="@color/white"
    android:id="@+id/btnSave"
    app:cornerRadius="12sp"
    android:fontFamily="@font/vazirmatn_bold"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
<!--  LOADING VIEW  -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        android:padding="12sp"
        android:focusable="false"
        android:id="@+id/loading">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="250sp"
                android:layout_height="250sp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/icon"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:hint="نام"
                app:boxBackgroundMode="outline"
                android:focusable="false"
                app:boxCornerRadiusTopStart="12sp"
                app:boxCornerRadiusTopEnd="12sp"
                app:boxCornerRadiusBottomStart="12sp"
                app:boxCornerRadiusBottomEnd="12sp"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_light"
                    android:inputType="textPersonName"
                    android:focusable="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:hint="خلاصه مهارت ها"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12sp"
                app:boxCornerRadiusTopEnd="12sp"
                app:boxCornerRadiusBottomStart="12sp"
                app:boxCornerRadiusBottomEnd="12sp"
                android:focusable="false"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:focusable="false"
                    android:fontFamily="@font/vazirmatn_light"/>
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24sp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1sp"
                    android:background="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شبکه های اجتماعی"
                    android:gravity="center"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:layout_weight="1"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1sp"
                    android:background="@color/black"
                    android:layout_weight="1"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:hint="تلگرام"
                app:boxCornerRadiusTopStart="12sp"
                app:boxCornerRadiusTopEnd="12sp"
                app:boxCornerRadiusBottomStart="12sp"
                app:boxCornerRadiusBottomEnd="12sp"
                app:boxBackgroundMode="outline"
                android:focusable="false"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_light"
                    android:focusable="false"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:hint="اینستاگرام"
                app:boxCornerRadiusTopStart="12sp"
                app:boxCornerRadiusTopEnd="12sp"
                app:boxCornerRadiusBottomStart="12sp"
                app:boxCornerRadiusBottomEnd="12sp"
                app:boxBackgroundMode="outline"
                android:focusable="false"
                app:boxBackgroundColor="@color/white">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_light"
                    android:focusable="false"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:textColor="@color/red"
                android:gravity="right"
                android:visibility="gone"
                android:fontFamily="@font/vazirmatn_extra_bold"/>
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:text="ذخیره"
                android:focusable="false"
                android:textColor="@color/white"
                app:cornerRadius="12sp"
                android:fontFamily="@font/vazirmatn_bold"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</RelativeLayout>